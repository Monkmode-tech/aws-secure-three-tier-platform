# Copy to terraform.tfvars (git-ignored) and edit.
# Never put AWS keys or passwords in this file: credentials come from your
# AWS CLI profile / SSO session, and the DB password is generated by RDS.

aws_region  = "us-east-2"
project     = "wp3t"
environment = "dev"
owner       = "caleb-tetteh"

# A public hosted zone in Route 53 for a domain you own. Leave empty to run
# in HTTP-only demo mode (no certificate, no DNS record).
domain_name   = "example.com"
app_subdomain = "app"

alert_email = "you@example.com"

# Cost levers (see docs/cost.md)
single_nat_gateway = true
db_multi_az        = true
min_capacity       = 2
max_capacity       = 6

# While running scripts/load-test.js from one machine, switch the WAF rate rule
# to "count" so your IP is measured instead of blocked. Switch back afterwards.
waf_rate_limit_action = "block"
